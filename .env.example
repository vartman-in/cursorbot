# Core WhatsApp and AI configuration
NODE_ENV=production
PORT=3000
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_BASE_URL=https://api.greenapi.com
OPENAI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Data and public service URL
FIREBASE_SERVICE_ACCOUNT_JSON=
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Dashboard staff security
# Generate a long random value; do not reuse a payment or WhatsApp token.
JWT_SECRET=replace-with-a-long-random-secret
STAFF_SESSION_TTL=8h
# Each passwordHash should be a bcrypt hash. Clinic IDs restrict each staff account.
STAFF_USERS_JSON=[{"email":"admin@yourclinic.in","name":"Clinic Administrator","passwordHash":"$2b$12$replace_with_bcrypt_hash","roles":["admin"],"clinicIds":["clinic-your-id"]}]

# Temporary bootstrap only; remove after STAFF_USERS_JSON is configured.
ADMIN_SECRET=replace-with-a-long-random-secret
DASHBOARD_ADMIN_EMAIL=admin@yourclinic.in
DASHBOARD_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Optional integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_REVIEW_URL=
HUMAN_AGENT_WHATSAPP=
